        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "marker_byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "done",
            "dropped",
            "blocked"
          ]
        }
      }
    },
    "result_trice_toggle_task": {
      "type": "object",
      "required": [
        "vault_root",
        "path",
        "marker_byte_offset",
        "state",
        "changed"
      ],
      "additionalProperties": true,
      "properties": {
        "vault_root": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "marker_byte_offset": {
          "type": "integer"
        },
        "state": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "params_trice_reschedule_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "due"
      ],
