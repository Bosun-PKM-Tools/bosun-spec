              "type": "string",
              "pattern": "^tt[0-9]+$"
            },
            "tmdb": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "bandcamp": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "musicbrainz": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "discogs": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "result_commonplace_resolve_id": {
      "type": "object",
      "required": [
