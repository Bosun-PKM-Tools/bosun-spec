{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/rpc/fleet-matrix.json",
  "title": "Bosun Fleet JSON-RPC 2.0 Method Matrix v1",
  "description": "Canonical catalog of the sixteen Yeoman / Trice / Logbook / Commonplace JSON-RPC 2.0 methods routed by harbormaster over stdio NDJSON (no sockets). Named params only (arrays are rejected). `$defs` holds JSON-RPC envelopes, per-method params/result schemas, and the catalog entry shape. The `methods` object is the reviewable catalog (same hybrid pattern as event-vocab-v0.1.json). Broadcast names are spec-level `info.<vessel>.*` events; harbormaster stub handlers do not emit them yet. Read methods list an empty broadcasts array.",
  "type": "object",
  "version": "1.0.0",
  "jsonrpc": "2.0",
  "transport": "stdio-ndjson",
  "errorCodes": {
    "parseError": -32700,
    "invalidRequest": -32600,
    "methodNotFound": -32601,
    "invalidParams": -32602
  },
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "transport": {
      "const": "stdio-ndjson"
    },
    "methods": {
      "type": "object",
      "minProperties": 16,
      "additionalProperties": {
        "$ref": "#/$defs/methodEntry"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "isoDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "eventStart": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})?)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)(?![/\\\\]).+$"
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^.*\\S.*$"
    },
    "jsonrpcId": {
      "description": "JSON-RPC 2.0 request id. Fleet methods are request/response, not notifications; id is required and must be a string or number.",
      "type": [
        "string",
        "number"
      ]
    },
    "jsonrpcErrorObject": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "data": true
      }
    },
    "jsonrpcErrorResponse": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "error": {
          "$ref": "#/$defs/jsonrpcErrorObject"
        }
      }
    },
    "jsonrpcSuccessResponse": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/jsonrpcId"
        },
        "result": {
          "type": "object"
        }
      }
    },
    "broadcastEvent": {
      "type": "object",
      "required": [
        "name",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^info\\.(yeoman|trice|logbook|commonplace)\\.[a-z_]+$"
        },
        "when": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "methodEntry": {
      "type": "object",
      "required": [
        "vessel",
        "method",
        "description",
        "mutates",
        "request",
        "result",
        "error",
        "broadcasts"
      ],
      "additionalProperties": false,
      "properties": {
        "vessel": {
          "type": "string",
          "enum": [
            "yeoman",
            "trice",
            "logbook",
            "commonplace"
          ]
        },
        "method": {
          "type": "string",
          "pattern": "^(yeoman|trice|logbook|commonplace)\\.[a-z_]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mutates": {
          "type": "boolean"
        },
        "request": {
          "type": "object",
          "required": [
            "jsonrpc",
            "method",
            "id",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "object",
              "required": [
                "required",
                "types"
              ],
              "additionalProperties": false,
              "properties": {
                "required": {
                  "const": true
                },
                "types": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            },
            "params": {
              "type": "object",
              "required": [
                "style",
                "required",
                "optional",
                "schemaRef"
              ],
              "additionalProperties": false,
              "properties": {
                "style": {
                  "const": "by-name"
                },
                "required": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "optional": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "schemaRef": {
                  "type": "string",
                  "pattern": "^#/\\$defs/params_[a-z_]+$"
                }
              }
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "jsonrpc",
            "schemaRef",
            "keys"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "schemaRef": {
              "type": "string",
              "pattern": "^#/\\$defs/result_[a-z_]+$"
            },
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "required": [
            "jsonrpc",
            "schemaRef",
            "codes"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "schemaRef": {
              "const": "#/$defs/jsonrpcErrorResponse"
            },
            "codes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "name",
                  "when"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "when": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "broadcasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/broadcastEvent"
          }
        }
      }
    },
    "params_yeoman_get_contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid",
          "description": "Yeoman contact UUID (contacts/<uuid>.md)."
        }
      }
    },
    "result_yeoman_get_contact": {
      "type": "object",
      "required": [
        "contact"
      ],
      "additionalProperties": true,
      "properties": {
        "contact": {
          "type": "object",
          "required": [
            "id",
            "name"
          ]
        }
      }
    },
    "params_yeoman_list_cadence_due": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of"
      ],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/isoDate",
          "description": "Inclusive cadence-due date (YYYY-MM-DD)."
        }
      }
    },
    "result_yeoman_list_cadence_due": {
      "type": "object",
      "required": [
        "as_of",
        "contacts"
      ],
      "additionalProperties": true,
      "properties": {
        "as_of": {
          "$ref": "#/$defs/isoDate"
        },
        "contacts": {
          "type": "array"
        }
      }
    },
    "params_yeoman_record_interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "occurred_at",
        "contact_id"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "occurred_at": {
          "$ref": "#/$defs/isoDateTime"
        },
        "contact_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "result_yeoman_record_interaction": {
      "type": "object",
      "required": [
        "path",
        "interaction"
      ],
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string"
        },
        "interaction": {
          "type": "object"
        }
      }
    },
    "params_yeoman_update_channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "emails"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "emails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/email"
          }
        }
      }
    },
    "result_yeoman_update_channels": {
      "type": "object",
      "required": [
        "contact"
      ],
      "additionalProperties": true,
      "properties": {
        "contact": {
          "type": "object",
          "required": [
            "id",
            "emails"
          ]
        }
      }
    },
    "params_trice_list_tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault_root"
      ],
      "properties": {
        "vault_root": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "#/$defs/relativePath",
          "description": "Optional vault-relative scan path. Defaults to '.'."
        }
      }
    },
    "result_trice_list_tasks": {
      "type": "object",
      "required": [
        "vault_root",
        "path",
        "tasks"
      ],
      "additionalProperties": true,
      "properties": {
        "vault_root": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "tasks": {
          "type": "array"
        }
      }
    },
    "params_trice_get_project_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Trice project identifier."
        }
      }
    },
    "result_trice_get_project_queue": {
      "type": "object",
      "required": [
        "project",
        "tasks"
      ],
      "additionalProperties": true,
      "properties": {
        "project": {
          "type": "object"
        },
        "tasks": {
          "type": "array"
        }
