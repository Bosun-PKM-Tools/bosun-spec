          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "frontmatter": {
          "type": "object"
        },
        "tasks": {
          "type": "array"
        },
        "time_blocks": {
          "type": "array"
        },
        "headings": {
          "type": "array"
        }
      }
    },
