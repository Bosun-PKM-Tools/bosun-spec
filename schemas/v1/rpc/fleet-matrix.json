        },
        "highlight": {
          "type": "string"
        },
        "appended": {
          "type": "boolean"
        }
      }
    }
  },
  "methods": {
    "yeoman.get_contact": {
      "vessel": "yeoman",
      "method": "yeoman.get_contact",
      "description": "Return the contact dossier at locker_yeoman/contacts/<uuid>.md.",
      "mutates": false,
      "request": {
        "jsonrpc": "2.0",
        "method": "yeoman.get_contact",
        "id": {
          "required": true,
          "types": [
            "string",
            "number"
          ]
        },
        "params": {
          "style": "by-name",
          "required": [
            "id"
          ],
          "optional": [],
          "schemaRef": "#/$defs/params_yeoman_get_contact"
        }
      },
      "result": {
        "jsonrpc": "2.0",
        "schemaRef": "#/$defs/result_yeoman_get_contact",
        "keys": [
          "contact"
        ]
      },
      "error": {
        "jsonrpc": "2.0",
        "schemaRef": "#/$defs/jsonrpcErrorResponse",
        "codes": [
          {
            "code": -32602,
            "name": "Invalid params",
            "when": "id missing or not a UUID; params not an object"
          }
        ]
      },
      "broadcasts": []
    },
    "yeoman.list_cadence_due": {
      "vessel": "yeoman",
      "method": "yeoman.list_cadence_due",
      "description": "List contacts whose follow-up cadence is due on or before as_of.",
      "mutates": false,
      "request": {
        "jsonrpc": "2.0",
        "method": "yeoman.list_cadence_due",
        "id": {
          "required": true,
          "types": [
            "string",
            "number"
          ]
        },
        "params": {
          "style": "by-name",
          "required": [
            "as_of"
          ],
          "optional": [],
