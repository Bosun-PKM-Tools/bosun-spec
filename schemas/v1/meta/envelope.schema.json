{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/meta/envelope.schema.json",
  "title": "Bosun Universal Meta-Envelope Contract v1",
  "description": "Universal Meta-Envelope contract ($pkm namespace) defining the required identity, canonical realm, timestamps, and typed relations.",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "$pkm"
  ],
  "properties": {
    "$pkm": {
      "$ref": "#/$defs/pkmEnvelope"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "pkmEnvelope": {
      "type": "object",
      "description": "Universal Meta-Envelope ($pkm namespace) identifying the entity, canonical realm, timestamps, and typed relations.",
      "required": [
        "id",
        "realm",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$",
          "description": "UUIDv7 URN uniquely identifying this entity."
        },
        "realm": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "description": "Lowercase canonical realm identifier."
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$",
          "description": "ISO-8601 UTC date-time string (Postel coercion: permissive ingestion of date strings missing seconds)."
        },
        "updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$",
          "description": "ISO-8601 UTC date-time string (Postel coercion: permissive ingestion of date strings missing seconds)."
        },
        "relations": {
          "type": "object",
          "description": "Map of typed predicate verbs to URN arrays.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^urn:[a-zA-Z0-9_.:-]+$"
                }
              },
              {
                "type": "string",
                "pattern": "^urn:[a-zA-Z0-9_.:-]+$"
              }
            ]
          }
        }
      },
      "additionalProperties": true
    }
  }
}
