{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/realms/42-reverie.schema.json",
  "title": "Bosun Realm 42: Reverie Contract v1",
  "description": "Machine-readable delta schema contract for Reverie (Realm 42), extending Archetype Interaction Ledger and Universal Meta-Envelope with realm-specific payload attributes.",
  "type": "object",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "https://bosunpkm.com/schemas/v1/archetypes/interaction-ledger.schema.json"
    },
    {
      "$ref": "https://bosunpkm.com/schemas/v1/meta/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "$pkm": {
          "type": "object",
          "properties": {
            "realm": {
              "const": "reverie",
              "description": "Canonical realm identifier for Reverie."
            }
          }
        },
        "dream_motif_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Archetypal symbols and recurring narrative dream motifs."
        },
        "lucidity_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Lucidity score from 0 (unconscious) to 5 (full waking control)."
        },
        "sleep_stage_anchor": {
          "type": "string",
          "enum": [
            "REM",
            "N1",
            "N2",
            "N3",
            "hypnagogic",
            "hypnopompic"
          ],
          "description": "Physiological sleep architecture stage anchoring the dream recall."
        }
      }
    }
  ],
  "additionalProperties": true
}
