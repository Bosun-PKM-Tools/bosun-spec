{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/realms/37-trajectory.schema.json",
  "title": "Bosun Realm 37: Trajectory Contract v1",
  "description": "Machine-readable delta schema contract for Trajectory (Realm 37), extending Archetype Catalog Dossier and Universal Meta-Envelope with realm-specific payload attributes.",
  "type": "object",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "https://bosunpkm.com/schemas/v1/archetypes/catalog-dossier.schema.json"
    },
    {
      "$ref": "https://bosunpkm.com/schemas/v1/meta/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "$pkm": {
          "type": "object",
          "properties": {
            "realm": {
              "const": "trajectory",
              "description": "Canonical realm identifier for Trajectory."
            }
          }
        },
        "role_title": {
          "type": "string",
          "description": "Professional or operational appointment title."
        },
        "organization_urn": {
          "type": "string",
          "pattern": "^urn:[a-zA-Z0-9_.:-]+$",
          "description": "URN referencing the employing or associated institution."
        },
        "tenure_start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Start date of appointment or tenure (YYYY-MM-DD)."
        },
        "case_study_slugs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Slugs of published portfolio projects or case studies."
        }
      }
    }
  ],
  "additionalProperties": true
}
