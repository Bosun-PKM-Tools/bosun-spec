{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/realms/01-bosun.schema.json",
  "title": "Bosun Realm 01: Bosun Contract v1",
  "description": "Machine-readable delta schema contract for Bosun (Realm 01), extending Archetype Stage-Gate Manifest with realm-specific payload attributes.",
  "type": "object",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "https://bosunpkm.com/schemas/v1/archetypes/stage-gate-manifest.schema.json"
    },
    {
      "$ref": "https://bosunpkm.com/schemas/v1/meta/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "$pkm": {
          "type": "object",
          "properties": {
            "realm": {
              "const": "bosun",
              "description": "Canonical realm identifier for Bosun."
            }
          }
        },
        "zettel_type": {
          "type": "string",
          "enum": [
            "structure",
            "concept",
            "reference",
            "fleeting",
            "hub",
            "index"
          ],
          "description": "Zettelkasten classification for the note."
        },
        "wikilinks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Obsidian/Roam style [[wikilinks]] referencing other notes."
        },
        "ast_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "description": "Semantic version of the Markdown AST parser output."
        }
      }
    }
  ],
  "additionalProperties": true
}
