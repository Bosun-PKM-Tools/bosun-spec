{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/realms/45-muster.schema.json",
  "title": "Bosun Realm 45: Muster Contract v1",
  "description": "Machine-readable delta schema contract for Muster (Realm 45), extending Archetype Catalog Dossier and Universal Meta-Envelope with realm-specific payload attributes.",
  "type": "object",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "https://bosunpkm.com/schemas/v1/archetypes/catalog-dossier.schema.json"
    },
    {
      "$ref": "https://bosunpkm.com/schemas/v1/meta/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "$pkm": {
          "type": "object",
          "properties": {
            "realm": {
              "const": "muster",
              "description": "Canonical realm identifier for Muster."
            }
          }
        },
        "rally_point_coordinates": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3,
          "description": "Geographic coordinates of contingency assembly location [lon, lat]."
        },
        "bug_out_tier": {
          "type": "string",
          "description": "Readiness tier classification (e.g. 'EDC', '72h', 'bug-out-bag', 'shelter-in-place')."
        },
        "ration_expiry_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Expiration date for emergency caloric provisions (YYYY-MM-DD)."
        },
        "comms_frequency_mhz": {
          "type": "number",
          "description": "Designated simplex / repeater emergency communications frequency in MHz."
        }
      }
    }
  ],
  "additionalProperties": true
}
