{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/realms/04-logbook.schema.json",
  "title": "Bosun Realm 04: Logbook Contract v1",
  "description": "Machine-readable delta schema contract for Logbook (Realm 04), extending Archetype Interaction Ledger with realm-specific payload attributes.",
  "type": "object",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "https://bosunpkm.com/schemas/v1/archetypes/interaction-ledger.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "$pkm": {
          "type": "object",
          "properties": {
            "realm": {
              "const": "logbook",
              "description": "Canonical realm identifier for Logbook."
            }
          }
        },
        "journal_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar day of this journal entry (YYYY-MM-DD)."
        },
        "agenda_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "Block description or title."
              },
              "start": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$",
                "description": "Start date-time of the agenda block."
              },
              "end": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$",
                "description": "End date-time of the agenda block."
              },
              "block_type": {
                "type": "string",
                "description": "Classification (focus, meeting, routine, buffer, etc.)."
              }
            },
            "additionalProperties": true
          },
          "description": "Time-blocked schedule or agenda segments."
        },
        "transclusion_anchors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Block-level transclusion reference anchors embedded in this log."
        }
      }
    }
  ],
  "additionalProperties": true
}
