{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/realms/17-supercargo.schema.json",
  "title": "Bosun Realm 17: Supercargo Contract v1",
  "description": "Machine-readable delta schema contract for Supercargo (Realm 17), extending Archetype Catalog Dossier with realm-specific payload attributes.",
  "type": "object",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "https://bosunpkm.com/schemas/v1/archetypes/catalog-dossier.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "$pkm": {
          "type": "object",
          "properties": {
            "realm": {
              "const": "supercargo",
              "description": "Canonical realm identifier for Supercargo."
            }
          }
        },
        "serial_number": {
          "type": "string",
          "description": "Manufacturer hardware serial number."
        },
        "mac_address": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
          "description": "Hardware MAC address for networkable equipment."
        },
        "warranty_expiry": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$",
          "description": "ISO-8601 warranty expiration date."
        }
      }
    }
  ],
  "additionalProperties": true
}
