{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosunpkm.com/schemas/v1/realms/39-claim.schema.json",
  "title": "Bosun Realm 39: Claim Contract v1",
  "description": "Machine-readable delta schema contract for Claim (Realm 39), extending Archetype Catalog Dossier and Universal Meta-Envelope with realm-specific payload attributes.",
  "type": "object",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "https://bosunpkm.com/schemas/v1/archetypes/catalog-dossier.schema.json"
    },
    {
      "$ref": "https://bosunpkm.com/schemas/v1/meta/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "$pkm": {
          "type": "object",
          "properties": {
            "realm": {
              "const": "claim",
              "description": "Canonical realm identifier for Claim."
            }
          }
        },
        "patent_number": {
          "type": "string",
          "description": "Registered patent or utility application identifier."
        },
        "jurisdiction_office": {
          "type": "string",
          "description": "Patent examination authority (e.g. 'USPTO', 'EPO', 'JPO')."
        },
        "filing_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Priority filing date (YYYY-MM-DD)."
        },
        "prior_art_urns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:[a-zA-Z0-9_.:-]+$"
          },
          "description": "URN references to cited prior art disclosures."
        }
      }
    }
  ],
  "additionalProperties": true
}
