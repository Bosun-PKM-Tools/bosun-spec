{
  "plan_id": "018f3a00-0000-7000-8000-0000000000f2",
  "title": "Invalid Primary↔Archive join with unknown vault id",
  "description": "Same sovereign bridge as primary-archive-join, but the join step targets an unknown vault alias that is not a legal endpoint identifier.",
  "version": "1.0.0",
  "vault_endpoints": {
    "primary": {
      "type": "local",
      "path": "fixtures/synthetic_vault",
      "alias": "primary",
      "read_only": true,
      "format": "markdown_pkm"
    },
    "archive": {
      "type": "stdio_rpc",
      "command": "harbormaster",
      "args": ["engine", "stdio", "--vault", "/vaults/archive"],
      "timeout_ms": 8000,
      "protocol": "jsonrpc-2.0"
    }
  },
  "distributed_steps": [
    {
      "step_id": "scan_primary_live_notes",
      "target_vault": "primary",
      "operation": "traverse",
      "query": {
        "linked_from": "urn:trice:task:018f3a00-0000-7000-8000-000000000003",
        "match_realm": ["trice", "yeoman"],
        "projections": ["nodes", "edges"]
      }
    },
    {
      "step_id": "join_unknown_vault",
      "target_vault": "ghost.vault",
      "operation": "join",
      "input_from_step": "scan_primary_live_notes",
      "join_with_step": "scan_primary_live_notes",
      "join_key": "task_derived_from_project",
      "join_type": "inner"
    }
  ],
  "join_keys": {
    "task_derived_from_project": {
      "key_id": "task_derived_from_project",
      "source_field": "$pkm.relations.actionItemDerivedFrom",
      "target_field": "$pkm.id",
      "matching_strategy": "exact_urn",
      "cardinality": "many_to_one"
    }
  }
}
